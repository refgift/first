BEGIN
	DENOTED A;
	DENOTED B;


	A := "title";
	B := "paper";
S:	IF A ? B  THEN 
	BEGIN
		OUTPUT A;
		OUTPUT SPACE;
		OUTPUT "matches"
		OUTPUT SPACE;
		OUTPUT B;
		OUTPUT NEWLINE
	END;
	OUTPUT "\nEnter Text Patterns a and b\n";
	INPUT A;
	OUTPUT COUNT A;
	OUTPUT TAB;
	INPUT B;
	OUTPUT COUNT B;
	OUTPUT TAB;
	YIELD ;
	GOTO S;

END

