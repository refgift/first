BEGIN
	DENOTED A;
	DENOTED B;
	DENOTED QUIT;
	QUIT := "BLANK";
	A := "title";
	B := "paper";
S:	IF A ? B  THEN 
	BEGIN
		OUTPUT "Match";
		OUTPUT SPACE;
		OUTPUT A;
		OUTPUT SPACE;
		OUTPUT B;
		OUTPUT NEWLINE
	END;
	OUTPUT "\nEnter Text Patterns a and b\n";
	INPUT A;
	OUTPUT COUNT A;
	INPUT B;
	OUTPUT COUNT B;
	YIELD ;
	IF A ? QUIT THEN GOTO T;
	GOTO S;
T:	OUTPUT "\nEnded\n";
END

