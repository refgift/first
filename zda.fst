BEGIN
	INTEGER RND;
	INTEGER ACCUMULATOR;
	INTEGER APPLY;

	ACCUMULATOR := 0;

S1:	RND := RANDOM;
	IF RND < 1 THEN RND := 0; 
	RND := RND % 9;
	IF RND < 1 THEN RND := 9;

	IF ACCUMULATOR = 200 THEN BEGIN 
		YIELD ; GOTO S2; 
	END
	IF ACCUMULATOR = 210 THEN BEGIN 
		YIELD ; GOTO S3; 
	END
	IF RND = 2 THEN BEGIN 
		ACCUMULATOR := 200;
		YIELD ;
		GOTO S1;
	END

S2:	IF RND = 1 THEN BEGIN
		ACCUMULATOR := 210;
		YIELD ;
		GOTO S1;
	END

S3:	IF RND = 5 THEN ACCUMULATOR := 215;

	IF ACCUMULATOR = 215 THEN BEGIN
		APPLY := 0;
		YIELD ;
		APPLY := 53;
		YIELD ;
		APPLY :=0;
		YIELD ;
	END
	GOTO S1
END