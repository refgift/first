BEGIN
	INTEGER RND;
	INTEGER ACCUMULATOR;
	INTEGER APPLY;
	INTEGER SWITCH;

 	INTEGER REJECT;
	REJECT := 94;

	INTEGER IGNORE;
	IGNORE := 105;

	INTEGER DENY;
	DENY := 60;

	ACCUMULATOR := 0;
	SWITCH := 0;

S1:	RND := RANDOM;
	IF RND < 1 THEN RND := 0; 
	RND := RND % 9;
	IF RND < 1 THEN RND := 9;

	IF ACCUMULATOR = 200 THEN JUMP S2; 

	IF ACCUMULATOR = 210 THEN JUMP S3; 

	IF RND = 2 THEN BEGIN 
		ACCUMULATOR := 200;
		YIELD ;
		JUMP S1;
	END
	YIELD;
	JUMP S1;

S2:	IF RND = 1 THEN BEGIN
		ACCUMULATOR := 210;
		YIELD ;
		JUMP S1;
	END
	YIELD;
	JUMP S1;

S3:	IF RND = 5 THEN ACCUMULATOR := 215;

	IF ACCUMULATOR = 215 THEN BEGIN
		INTEGER CASE;
		CASE := SWITCH % 3 ;
		APPLY := 0;
		YIELD ;
		IF CASE = 0 THEN APPLY := REJECT;
		IF CASE = 1 THEN APPLY := IGNORE;
		IF CASE = 2 THEN APPLY := DENY;
		YIELD ;
		APPLY := 0;
		YIELD ;
		ACCUMULATOR := 0;
		SWITCH := SWITCH + 1 ;
	END
	YIELD;
	JUMP S1
END