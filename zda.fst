BEGIN

	OUTPUT "zda - zero dude eliminator, (C) Copyright 2026 Larry B. Daniel, Atlanta, Ga."
	OUTPUT NEWLINE;

	INTEGER RND;
	INTEGER ACCUMULATOR;
	INTEGER APPLY;

	INTEGER DELAY;
	DELAY  := 25000;

	INTEGER INSTIGATOR;
	INSTIGATOR := 161;

	ACCUMULATOR := 0;

S1:	YIELD;
	
	RND := RANDOM;
	RND := ROOT;

	IF ACCUMULATOR = 100 THEN JUMP S2; 
	IF ACCUMULATOR = 160 THEN JUMP S3; 

	IF RND = 1 THEN ACCUMULATOR := 100;
	JUMP S1;

S2:	IF RND = 6 THEN ACCUMULATOR := 160;
	JUMP S1;

S3:	IF RND = 1 THEN ACCUMULATOR := INSTIGATOR;

	IF ACCUMULATOR = INSTIGATOR THEN BEGIN
		APPLY := 0;
		TIMED DELAY ;
		APPLY := INSTIGATOR;
		TIMED DELAY ;
		APPLY := 0;
		TIMED DELAY ;
		ACCUMULATOR := 0;
	END
	JUMP S1
END