BEGIN
	DENOTED QUERY;

	DENOTED T;
	T := "ERROR";

	INTEGER C;

S0:	YIELD ;
	INPUT QUERY;

	IF QUERY ? T THEN BEGIN OUTPUT QUERY; OUTPUT SPACE; OUTPUT "GRAMMAR"; OUTPUT NEWLINE; JUMP S0;  END 
	IF QUERY ~ T THEN BEGIN OUTPUT QUERY; OUTPUT SPACE; OUTPUT "SYNTAX"; OUTPUT NEWLINE; JUMP S0; END 	

	JUMP S0;	

OVER:	RETURN 0;
END
